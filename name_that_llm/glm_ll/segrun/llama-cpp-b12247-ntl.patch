diff --git a/src/models/ntl-segment.h b/src/models/ntl-segment.h
new file mode 100644
index 0000000..2e2dea8
--- /dev/null
+++ b/src/models/ntl-segment.h
@@ -0,0 +1,27 @@
+#pragma once
+// [ntl-segrun] shared bits of the layer-segment patch (glm5-next, glm-dsa)
+
+#include "llama-graph.h"
+#include "llama-batch.h"
+
+#include "ggml-backend.h"
+
+// residual stream fed from ubatch.embd, [n_state, n_tokens] (n_state = hc*n_embd for glm5-next, n_embd for glm-dsa)
+class llm_graph_input_ntl_state : public llm_graph_input_i {
+public:
+    llm_graph_input_ntl_state(int64_t n_state) : n_state(n_state) {}
+
+    void set_input(const llama_ubatch * ubatch) override {
+        GGML_ASSERT(ubatch->embd && !ubatch->token && "ntl segment: this segment takes the hc state (batch.embd), not tokens");
+        ggml_backend_tensor_set(state, ubatch->embd, 0, ubatch->n_tokens*n_state*ggml_element_size(state));
+    }
+
+    bool can_reuse(const llm_graph_params & params) override {
+        return state->ne[1] == params.ubatch.n_tokens;
+    }
+
+    ggml_tensor * state = nullptr; // F32 [hc*n_embd, n_tokens]
+
+    const int64_t n_state;
+};
+
